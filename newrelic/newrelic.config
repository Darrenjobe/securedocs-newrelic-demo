<?xml version="1.0"?>
<!--
  New Relic .NET agent configuration for the SecureDocs demo (copied over the agent's default config
  on build and publish — see the NewRelicConfig target in each .csproj).
  License key and app name come from environment variables set on each App Service:
    NEW_RELIC_LICENSE_KEY, NEW_RELIC_APP_NAME
-->
<configuration xmlns="urn:newrelic-config" agentEnabled="true">
  <service licenseKey="REPLACE_WITH_LICENSE_KEY" />
  <application>
    <name>SecureDocs</name>
  </application>
  <log level="info" />

  <!-- Request headers are captured, but never cookies, auth tokens or API keys. -->
  <allowAllHeaders enabled="true" />
  <attributes enabled="true">
    <exclude>request.headers.cookie</exclude>
    <exclude>request.headers.authorization</exclude>
    <exclude>request.headers.proxy-authorization</exclude>
    <exclude>request.headers.x-*</exclude>
    <include>request.headers.*</include>
  </attributes>

  <!-- Distributed tracing: Portal → API → (address service) → Azure SQL in one trace. -->
  <distributedTracing enabled="true" />
  <spanEvents enabled="true" />

  <!-- Transaction traces for anything slower than 1 s, with obfuscated SQL and explain plans for slow queries. -->
  <transactionTracer enabled="true" transactionThreshold="1" stackTraceThreshold="200"
                     recordSql="obfuscated" explainEnabled="true" explainThreshold="200" />
  <slowSql enabled="true" />
  <!-- Never send SQL parameter values: they could contain PHI. -->
  <datastoreTracer>
    <queryParameters enabled="false" />
  </datastoreTracer>

  <errorCollector enabled="true">
    <ignoreStatusCodes>
      <code>401</code>
      <code>404</code>
    </ignoreStatusCodes>
  </errorCollector>

  <!-- Logs in context: ILogger output is forwarded and linked to traces/errors. -->
  <applicationLogging enabled="true">
    <forwarding enabled="true" />
  </applicationLogging>

  <codeLevelMetrics enabled="true" />

  <!-- Injects the browser agent into portal pages (requires browser monitoring enabled for the app). -->
  <browserMonitoring autoInstrument="true" />
</configuration>
